# ============================================
# Environment Variables Template
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# For Docker development:
#   docker compose up -d
# For Docker production:
#   docker compose -f docker-compose.prod.yml up -d
#
# Database: Use Supabase (staging for dev, production for prod).
# Get connection details from your Supabase Dashboard -> Settings -> Database.
# ============================================

# --------------------------------------------
# PostgreSQL / Supabase
# --------------------------------------------
# DB_HOST: Use your Supabase connection URL.
#   Example: db.xxxxxxxxxxxxx.supabase.co
#   For local dev without Docker: localhost
DB_HOST=localhost

# DB_PORT: Supabase PostgreSQL port (usually 5432)
DB_PORT=5432

# DB_NAME: Your Supabase database name (usually 'postgres')
DB_NAME=ranking_groups

# DB_USER: Your Supabase database user (usually 'postgres')
DB_USER=postgres

# DB_PASSWORD: Your Supabase database password
DB_PASSWORD=postgres

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
# JWT_SECRET: Minimum 32 characters. Used to sign access tokens.
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-min-32-characters-long

# JWT_REFRESH_SECRET: Minimum 32 characters. Used to sign refresh tokens.
# MUST be different from JWT_SECRET.
JWT_REFRESH_SECRET=your-refresh-secret-key-here-min-32-characters-long

# JWT_ISSUER: Token issuer identifier
JWT_ISSUER=ranking-groups

# JWT_AUDIENCE: Token audience identifier
JWT_AUDIENCE=ranking-groups

# JWT_ACCESS_EXPIRATION_MINUTES: Access token lifetime (minutes)
JWT_ACCESS_EXPIRATION_MINUTES=15

# JWT_REFRESH_EXPIRATION_DAYS: Refresh token lifetime (days)
JWT_REFRESH_EXPIRATION_DAYS=7

# --------------------------------------------
# CORS / Frontend
# --------------------------------------------
# FRONTEND_URL: Comma-separated list of allowed frontend origins.
# For local dev: http://localhost:5173
# For production: https://your-domain.com
# If multiple: http://localhost:5173,https://your-domain.com
FRONTEND_URL=http://localhost:5173

# --------------------------------------------
# Quartz Scheduling
# --------------------------------------------
# QUARTZ_CRON: Cron expression for the nightly cleanup job.
# Default: 0 0 0 * * ? (midnight UTC every day)
# Examples:
#   - 0 0 0 * * ?       → Midnight UTC daily
#   - 0 0 3 * * ?       → 3 AM UTC daily
#   - 0 0 0 ? * MON     → Midnight UTC every Monday
QUARTZ_CRON=0 0 0 * * ?

# --------------------------------------------
# Supabase Storage
# --------------------------------------------
# SUPABASE_URL: Your Supabase project URL.
#   Example: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://xgxfljaruqzcudmrqyzu.supabase.com

# SUPABASE_SERVICE_KEY: Your Supabase service_role key.
#   WARNING: Keep this secret. Never expose to frontend.
#   Get from Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --------------------------------------------
# (Optional) Frontend Build-time
# --------------------------------------------
# VITE_API_BASE_URL: Used by the frontend to know the backend URL.
# In Docker dev, this is set in docker-compose.yml.
# For local dev without Docker: http://localhost:8080
# VITE_API_BASE_URL=http://localhost:8080

# VITE_SUPABASE_URL: Used by the frontend to build public image URLs.
# VITE_SUPABASE_URL=https://xgxfljaruqzcudmrqyzu.supabase.co
